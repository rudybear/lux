// Explicit aux_precision: half variant of gaussian_splat_dlss.lux
// (bench/lux_perf_ablation.md task 2 follow-up): out_aux as RGBA16F
// (mv.x*alpha, mv.y*alpha, depth*alpha, alpha) instead of RGBA32F --
// 8B/px vs. 16B/px for out_aux. out_fg stays RGBA16F (fg*alpha, 0, 0,
// alpha) regardless -- an earlier version of this option also shrank
// out_fg to RG16F under "half", which broke the fixed-function blend
// outright (the blend reads "source alpha" from each blended
// attachment's own 4th component, and a 2-channel format has none), not
// merely a precision tradeoff; see splat_renderer.h's getFgFormat()
// comment.
//
// NOTE: `aux_precision: half` is now `gaussian_splat_dlss.lux`'s own
// DEFAULT (i.e. this file is functionally IDENTICAL to it -- both
// compile to the same reflected "aux_precision": "half"), because the
// out_fg fix above makes it safe, and the MODEL-LEVEL verdict (the
// actual mobiledlss DLSS reconstructor, not a pixel-exact comparison)
// found "half" indistinguishable from "float": 35.494 vs 35.491 dB PSNR
// on lux-rendered clips, fg bit-exact, mv 0.008px, depth 0.4% -- all
// invisible to the reconstructor. (out_aux's own half-float
// blend-accumulation rounding DOES fail this repo's original tight
// pixel-level bar, <=0.01px MV / <=1e-3-relative depth --
// tests/test_dlss_outputs.py's tolerances were loosened to <=0.02px /
// <=1e-2-relative to reflect the model-level result instead.) This file
// is kept anyway as an explicit, self-documenting example of setting
// `aux_precision: half` on a splat block (useful as a template, and for
// any caller/test that wants to pin the "half" behavior by name rather
// than relying on the current default) -- see gaussian_splat_dlss.lux
// for the base pipeline this mirrors, and splat_renderer.h's
// getAuxFormat()/getFgFormat() comments for exactly what changes
// host-side (the compiled shader itself is identical either way --
// aux_precision is a host format hint, not a codegen switch). To use
// the pixel-precise "float" option instead, set `aux_precision: float`
// explicitly on a splat block (no example file for it currently exists,
// since "float" used to be the implicit default and had one for free).
//
// Compile: python -m luxc examples/gaussian_splat_dlss_half.lux

splat DlssGaussianCloudHalf {
    sh_degree: 0,
    kernel: ellipse,
    color_space: linear,
    sort: view_depth,
    alpha_cutoff: 0.004,
    motion: keyframes,
    motion_vectors: true,
    expected_depth: true,
    foreground_coverage: true,
    aux_precision: half,
}

pipeline DlssSplatViewerHalf {
    mode: gaussian_splat,
    splat: DlssGaussianCloudHalf,
}
