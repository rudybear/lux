// DLSS input-contract outputs: motion vectors + expected depth
// (docs/lux-4d-spec.md section 3, SPECIFICATION.md 12.8).
//
// Identical to gaussian_splat_dynamic.lux except for `motion_vectors: true`,
// `expected_depth: true`, and `foreground_coverage: true`, which make the
// preprocess/vertex/fragment stages carry these extra premultiplied-alpha
// outputs:
//   out_motion (RG): backward per-splat motion vector in pixels
//                     (prev_uv = uv - mv, origin top-left, +y down)
//   out_depth  (R):  alpha-weighted camera-space z (gsplat's "ED" mode)
//   out_depth  (G):  alpha-weighted per-splat foreground/actor coverage
//                     flag (foreground_coverage packs into out_depth's
//                     otherwise-unused .g channel rather than adding a
//                     4th attachment -- SPECIFICATION.md 12.8)
//
// Compile: python -m luxc examples/gaussian_splat_dlss.lux
//   -> gaussian_splat_dlss.morph.comp.spv (motion: keyframes morph-apply)
//   -> gaussian_splat_dlss.comp.spv       (preprocess: projects prev frame
//                                           too, writes projected_mv/_depth/
//                                           _foreground)
//   -> gaussian_splat_dlss.vert.spv / .frag.spv (carry frag_mv/frag_depth/
//                                                 frag_foreground, write
//                                                 out_motion/out_depth)

splat DlssGaussianCloud {
    sh_degree: 0,
    kernel: ellipse,
    color_space: linear,
    // view_depth (not the camera_distance spec default -- SPECIFICATION.md
    // 12.8): this pipeline's whole purpose is producing DLSS input-contract
    // outputs (proxy colour/MV/depth) for a downstream network trained
    // against the 3DGS/gsplat reference convention, so its sort key must
    // match theirs. Measured on juggle frame 40 (sync bugs fixed): 49.4 dB
    // colour PSNR + exact depth vs. gsplat with view_depth, vs. only
    // 30.9 dB / 0.8% depth median rel. error with camera_distance.
    sort: view_depth,
    alpha_cutoff: 0.004,
    motion: keyframes,
    motion_vectors: true,
    expected_depth: true,
    foreground_coverage: true,
}

pipeline DlssSplatViewer {
    mode: gaussian_splat,
    splat: DlssGaussianCloud,
}
