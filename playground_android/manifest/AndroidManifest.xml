<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lux.playgroundandroid"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" />

    <application
        android:hasCode="false"
        android:label="Lux Playground"
        android:debuggable="true">
        <!-- LiteRT Next GPU path (docs/rendering-engines.md): apps targeting
             Android S+ (API 31+, we target 35) must explicitly declare any
             vendor-provided native library they dlopen(), or the linker
             namespace hides it and dlopen() silently fails: exactly what
             was happening here (libLiteRt.so's GPU accelerator plugin fell
             back from OpenCL to OpenGL with "OpenCL not supported on this
             platform", even though `adb shell` run standalone binaries, a
             different unrestricted linker namespace, load the SAME device
             OpenCL driver fine). Copied verbatim from the
             com.google.ai.edge.litert:litert:2.1.6 AAR's own
             AndroidManifest.xml (Gradle merges these into any app that
             depends on the AAR automatically; this hand built manifest has
             no Gradle merge step, so they're vendored here instead).
             libOpenCL-pixel.so is this exact device's (Pixel 9 Pro XL)
             vendor OpenCL driver name. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <activity
            android:name="android.app.NativeActivity"
            android:label="Lux Playground"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="lux_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
